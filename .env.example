# Required
DERIV_TOKEN=                 # Deriv API token (real account)
DERIV_APP_ID=1089            # Default Deriv app id

# Risk caps
STAKE=40                     # Per-trade base stake (adaptive shift modulates this down)
DAILY_MAX_LOSS=50            # Hard pause if daily loss reaches this

# Contract config
CONTRACT_FAMILY=MULTIPLIER   # MULTIPLIER or CALL_PUT
MULTIPLIER=30                # Multiplier value (MULTIPLIER family only)
DURATION_TICKS=10            # Tick duration (CALL_PUT family only)
TP_SL_MODE=atr               # atr or percent
ATR_TP_MULT=2                # TP at N×ATR price move (atr mode)
ATR_SL_MULT=1                # SL at N×ATR price move (atr mode)
TP_PCT=20                    # Take-profit %, percent mode
SL_PCT=10                    # Stop-loss %, percent mode

# Lifecycle
LIVE_TRADING=false           # SAFETY: keep false for dry-run; flip to true to actually place orders
STATE_DIR=./state            # Where bot-state.json is persisted; on Railway, mount a volume here
PORT=3000                    # HTTP health/state endpoint; Railway injects PORT automatically
LOG_LEVEL=info               # trace | debug | info | warn | error
