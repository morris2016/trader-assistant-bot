# Railway Variables — paste this entire file into:
#   Railway Dashboard → Service → Variables → Raw Editor → Paste
#
# After pasting, Railway creates EVERY variable below in the dashboard.
# Tweak values directly in the Railway UI — no need to redeploy code.
# Only ONE value needs replacing: DERIV_TOKEN.

# ─── REQUIRED — replace placeholder ──────────────────────────────────────
DERIV_TOKEN=REPLACE_WITH_YOUR_DERIV_API_TOKEN

# ─── Safety (start dry; flip to true after 24-48h verification) ─────────
LIVE_TRADING=false

# ─── Risk caps (USD) ─────────────────────────────────────────────────────
STAKE=40
DAILY_MAX_LOSS=50

# ─── Contract config (matches validated strategies) ─────────────────────
CONTRACT_FAMILY=MULTIPLIER
MULTIPLIER=30
TP_SL_MODE=atr
ATR_TP_MULT=2
ATR_SL_MULT=1
DURATION_TICKS=10
TP_PCT=20
SL_PCT=10

# ─── Lifecycle / infra ──────────────────────────────────────────────────
DERIV_APP_ID=1089
LOG_LEVEL=info
# STATE_DIR — set by Dockerfile to /app/state (mount Railway volume there)
# PORT     — auto-injected by Railway, do NOT set
