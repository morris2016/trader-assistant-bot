# Railway Variables — paste this entire block into:
#   Railway Dashboard → Service → Variables → Raw Editor
#
# Only ONE secret is required. Everything else (stake, R:R, multiplier, etc.)
# has sensible defaults baked into the Docker image — only set them here if
# you want to override the default. Replace the REPLACE_* placeholder below.

# ─── REQUIRED (the only one you must change) ─────────────────────────────
DERIV_TOKEN=REPLACE_WITH_YOUR_DERIV_API_TOKEN

# ─── OPTIONAL OVERRIDES (delete any line you don't want to override) ─────
# Image defaults shown in comments. Uncomment + change to override.

# LIVE_TRADING=false      # default: false. Flip to true to actually place orders.
# STAKE=40                # default: 40. Per-trade base stake in USD.
# DAILY_MAX_LOSS=50       # default: 50. Hard pause if daily loss reaches this.
# LOG_LEVEL=info          # default: info. trace | debug | info | warn | error.
# MULTIPLIER=30           # default: 30. Multiplier value (MULTIPLIER family).
# ATR_TP_MULT=2           # default: 2. TP at N×ATR price move.
# ATR_SL_MULT=1           # default: 1. SL at N×ATR price move.
